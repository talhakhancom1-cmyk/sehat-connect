# Environment
.env
.env.*
!.env.example
!deploy/env.*.example

# Build-time env (generated by deploy — do not commit)
.env.production
frontend/.env.production

# Nginx config (generated by deploy with correct domain — do not commit)
backend/nginx.conf

# Internal docs (not needed for deployment)
DEVELOPER_GUIDE.md
ISSUES.md
TEST_ACCOUNTS.md

# Logs
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules

# Build output
dist
frontend/dist

# Backups (contain secrets — never commit)
backups/
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Vite
.vite
frontend/.vite

# Backend uploads (now in MinIO, but keep for local dev)
backend/uploads/
backend/logs/

# Migration artifacts (do not commit)
vps-export/
scripts/
generate-pdf.cjs
