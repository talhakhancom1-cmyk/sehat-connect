# ---- WebRTC ICE servers (STUN + TURN for NAT traversal) ----
# STUN is free (Google's public servers). TURN relays media when STUN fails
# (symmetric NAT, carrier NAT, corporate firewalls). Self-host coturn on a
# separate VPS — see deploy-turn.sh at the project root.
# Comma-separated list of ICE server URLs.
ICE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
ICE_TURN_URLS=turn:74.x.x.x:3478
ICE_TURN_USERNAME=sehat
ICE_TURN_CREDENTIAL=changeme-to-a-strong-secret

# ---- Calling ----
# How long (ms) to ring before auto-cancelling an unanswered call.
CALL_RING_TIMEOUT_MS=30000
