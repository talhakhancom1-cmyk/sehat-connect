# ================================================================
# Sehat Connect Backend — Environment Configuration
# ================================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# ---- Server ----
PORT=3000
NODE_ENV=production

# ---- PostgreSQL ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sehat_connect
DB_USER=sehat
DB_PASSWORD=changeme

# ---- Security (MUST set in production) ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=changeme-to-a-64-char-random-string
FILE_DOWNLOAD_SECRET=changeme-to-a-64-char-random-string

# ---- CORS ----
# Comma-separated list of allowed origins, or * for any
CORS_ORIGIN=https://ehcserver.webfrat.com

# ---- Admin seed (optional — set to create initial admin on first boot) ----
# Remove or leave blank after first deployment
ADMIN_EMAIL=admin@sehat.local
ADMIN_PASSWORD=changeme

# ---- MinIO (S3-compatible object storage) ----
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme
MINIO_BUCKET=sehat-uploads
MINIO_PUBLIC_BASE_URL=https://ehcserver.webfrat.com/files
