# ================================================================
# EcoHealth Backend — Environment Configuration
# ================================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# ---- Server ----
PORT=3000
NODE_ENV=production

# ---- PostgreSQL ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecohealth
DB_USER=sehat
DB_PASSWORD=changeme

# ---- Security (MUST set in production) ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=changeme-to-a-64-char-random-string
FILE_DOWNLOAD_SECRET=changeme-to-a-64-char-random-string

# ---- CORS ----
# Comma-separated list of allowed origins, or * for any
# In split architecture, include BOTH the app domain and the WS domain.
# Example: CORS_ORIGIN=https://ehcserver.webfrat.com,https://afridiwins.online
CORS_ORIGIN=https://afridiwins.online

# ---- Admin seed (optional — set to create initial admin on first boot) ----
# Remove or leave blank after first deployment
ADMIN_EMAIL=admin@ecohealth.local
ADMIN_PASSWORD=changeme

# ---- MinIO (S3-compatible object storage) ----
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme
MINIO_BUCKET=ecohealth-uploads
MINIO_PUBLIC_BASE_URL=https://afridiwins.online/files

# ---- WebRTC ICE servers (STUN + TURN for NAT traversal) ----
# STUN is free (Google's public servers). TURN relays media when STUN fails
# (symmetric NAT, carrier NAT, corporate firewalls). Self-host coturn on a
# separate VPS — see deploy-turn.sh at the project root.
# Comma-separated list of ICE server URLs.
ICE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
ICE_TURN_URLS=turn:74.x.x.x:3478
ICE_TURN_USERNAME=sehat
ICE_TURN_CREDENTIAL=changeme-to-a-strong-secret

# ---- Calling ----
# How long (ms) to ring before auto-cancelling an unanswered call.
CALL_RING_TIMEOUT_MS=30000

# ---- Internal service-to-service API (split architecture) ----
# Shared secret for the /internal endpoints (DND + caller identity lookups).
# MUST be identical on ehcserver and afridiwins.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
INTERNAL_API_SECRET=changeme-to-a-64-char-random-string

# On afridiwins ONLY: the base URL of ehcserver's internal API.
# Leave blank on ehcserver (it serves the endpoint, doesn't call it).
# INTERNAL_API_BASE=https://ehcserver.webfrat.com

# ---- AI Symptom Checker ----
# OpenAI API key for the symptom checker feature (chat completions + moderation).
# NEVER expose this to the frontend. Leave blank to disable the symptom checker.
OPENAI_API_KEY=
