# ================================================================
# EcoHealth — App Server .env Example
# (e.g. ehcserver.webfrat.com: frontend + REST API + DB + MinIO)
# ================================================================
# Copy to backend/.env and replace all <...> placeholders with real values.
# NEVER commit .env to git.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# ---- Server ----
PORT=3000
NODE_ENV=production

# ---- PostgreSQL ----
# The app server hosts the primary database.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecohealth
DB_USER=sehat
DB_PASSWORD=<YOUR_DB_PASSWORD_HERE>

# ---- Security (generate strong random hex strings) ----
# Used to sign JWT auth tokens. MUST be identical on both servers.
JWT_SECRET=<GENERATE_SECURE_RANDOM_VALUE>
# Used to generate/verify file download tokens. MUST be identical on both servers.
FILE_DOWNLOAD_SECRET=<GENERATE_SECURE_RANDOM_VALUE>

# ---- CORS ----
# Comma-separated list of allowed origins.
# Include both the app domain and the signaling server domain.
CORS_ORIGIN=https://<APP_SERVER_DOMAIN>,https://<SIGNALING_SERVER_DOMAIN>

# ---- Admin seed (set for first boot, remove after) ----
ADMIN_EMAIL=admin@<APP_SERVER_DOMAIN>
ADMIN_PASSWORD=<GENERATE_SECURE_PASSWORD>

# ---- MinIO (S3-compatible object storage) ----
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=<YOUR_MINIO_ACCESS_KEY>
MINIO_SECRET_KEY=<YOUR_MINIO_SECRET_KEY>
MINIO_BUCKET=ecohealth-uploads
MINIO_PUBLIC_BASE_URL=https://<APP_SERVER_DOMAIN>/files

# ---- Internal service-to-service API ----
# Shared secret for /internal endpoints (DND + caller identity lookups).
# The signaling server calls these endpoints on the app server.
# MUST be identical on both servers.
INTERNAL_API_SECRET=<GENERATE_SECURE_RANDOM_VALUE>
# Leave blank on the app server (it serves the endpoint, doesn't call it).
# INTERNAL_API_BASE=https://<APP_SERVER_DOMAIN>

# ---- WebRTC ICE servers (STUN + TURN) ----
# STUN is free (Google's public servers).
# TURN relays media when STUN fails (symmetric NAT, corporate firewalls).
# Point to the signaling server's coturn instance.
ICE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
ICE_TURN_URLS=turn:<SIGNALING_SERVER_DOMAIN>:3478
ICE_TURN_USERNAME=<TURN_USERNAME>
ICE_TURN_CREDENTIAL=<TURN_CREDENTIAL>

# ---- Calling ----
# How long (ms) to ring before auto-cancelling an unanswered call.
CALL_RING_TIMEOUT_MS=30000

# ---- AI Symptom Checker ----
# OpenAI API key for the symptom checker (chat completions + moderation).
# NEVER expose this to the frontend.
# Leave blank to disable — can also be set from Admin > AI Config panel.
OPENAI_API_KEY=

# ---- Email (optional — can also be configured from Admin > Email / SMTP) ----
# If set here, these override the database email config.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@<APP_SERVER_DOMAIN>
