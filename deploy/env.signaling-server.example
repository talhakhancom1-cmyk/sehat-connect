# ================================================================
# EcoHealth — Signaling Server .env Example
# (e.g. afridiwins.online: WebSocket + TURN + MinIO legacy uploads)
# ================================================================
# Copy to backend/.env and replace all <...> placeholders with real values.
# NEVER commit .env to git.
#
# CRITICAL: JWT_SECRET, FILE_DOWNLOAD_SECRET, and INTERNAL_API_SECRET
# MUST be identical to the app server's values. Copy them from the
# app server's backend/.env file.

# ---- Server ----
PORT=3000
NODE_ENV=production

# ---- PostgreSQL ----
# The signaling server has its own local database for calls/messages.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecohealth
DB_USER=sehat
DB_PASSWORD=<YOUR_DB_PASSWORD_HERE>

# ---- Security (MUST match app server exactly) ----
# Used to verify JWT auth tokens issued by the app server.
JWT_SECRET=<COPY_FROM_APP_SERVER>
# Used to verify file download tokens generated by the app server.
FILE_DOWNLOAD_SECRET=<COPY_FROM_APP_SERVER>

# ---- CORS ----
# Include both domains.
CORS_ORIGIN=https://<SIGNALING_SERVER_DOMAIN>,https://<APP_SERVER_DOMAIN>

# ---- MinIO (S3-compatible object storage for legacy uploads) ----
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=<YOUR_MINIO_ACCESS_KEY>
MINIO_SECRET_KEY=<YOUR_MINIO_SECRET_KEY>
MINIO_BUCKET=ecohealth-uploads
MINIO_PUBLIC_BASE_URL=https://<SIGNALING_SERVER_DOMAIN>/files

# ---- Internal service-to-service API ----
# Shared secret for /internal endpoints. MUST match app server.
INTERNAL_API_SECRET=<COPY_FROM_APP_SERVER>
# Base URL of the app server's internal API (for DND + caller identity lookups).
INTERNAL_API_BASE=https://<APP_SERVER_DOMAIN>

# ---- WebRTC ICE servers (STUN + TURN) ----
# This server hosts the TURN relay (coturn).
ICE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
ICE_TURN_URLS=turn:<SIGNALING_SERVER_DOMAIN>:3478
ICE_TURN_USERNAME=<TURN_USERNAME>
ICE_TURN_CREDENTIAL=<TURN_CREDENTIAL>

# ---- Calling ----
CALL_RING_TIMEOUT_MS=30000

# ---- AI Symptom Checker (optional on signaling server) ----
# Leave blank to disable. Can also be set from Admin > AI Config panel.
OPENAI_API_KEY=
